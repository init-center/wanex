{
  "name": "@wanex/eval-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "wanex-eval": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "scripts": {
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node ../../scripts/run-package-test.mjs",
    "eval": "tsx ./src/cli.ts"
  },
  "dependencies": {
    "@wanex/app": "workspace:*",
    "@wanex/extension": "workspace:*",
    "@wanex/cli": "workspace:*",
    "@wanex/plugin": "workspace:*",
    "@wanex/assistant": "workspace:*",
    "@wanex/assistant-plugin-host": "workspace:*",
    "@wanex/assistant-host": "workspace:*",
    "@wanex/tui": "workspace:*",
    "@wanex/assistant-ui": "workspace:*",
    "@wanex/protocol": "workspace:*",
    "@wanex/runtime": "workspace:*",
    "@wanex/storage": "workspace:*",
    "@wanex/storage-control-plane": "workspace:*",
    "@wanex/team": "workspace:*",
    "@wanex/workspace": "workspace:*"
  }
}
