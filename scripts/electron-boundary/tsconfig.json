{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "paths": {
      "@wanex/protocol": ["../../packages/protocol/src/index.ts"],
      "@wanex/storage": ["../../packages/storage/src/index.ts"],
      "@wanex/storage/*": ["../../packages/storage/src/*/index.ts", "../../packages/storage/src/*.ts"],
      "@wanex/runtime": ["../../packages/runtime/src/index.ts"],
      "@wanex/runtime/*": ["../../packages/runtime/src/*/index.ts", "../../packages/runtime/src/*.ts"],
      "@wanex/extension": ["../../packages/extension/src/index.ts"],
      "@wanex/extension/*": ["../../packages/extension/src/*/index.ts", "../../packages/extension/src/*.ts"],
      "@wanex/app": ["../../packages/app/src/index.ts"],
      "@wanex/app/*": ["../../packages/app/src/*/index.ts", "../../packages/app/src/*.ts"],
      "@wanex/product-app": ["../../apps/product-app/src/index.ts"],
      "@wanex/product-app/*": ["../../apps/product-app/src/*/index.ts", "../../apps/product-app/src/*.ts"],
      "@wanex/product-app-web": ["../../apps/product-app-web/src/index.ts"],
      "@wanex/product-app-web/*": ["../../apps/product-app-web/src/*/index.ts", "../../apps/product-app-web/src/*.ts"],
      "@wanex/product-app-local": ["../../apps/product-app-local/src/index.ts"],
      "@wanex/product-app-local/*": ["../../apps/product-app-local/src/*/index.ts", "../../apps/product-app-local/src/*.ts"]
    }
  },
  "include": ["./*.ts"]
}
