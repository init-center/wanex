{
  "name": "@wanex/assistant-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./host": "./src/application/host.ts",
    "./client": "./src/client/index.ts",
    "./generated/client-script": "./src/generated/client-script.ts",
    "./generated/stylesheet": "./src/generated/stylesheet.ts",
    "./styles.css": "./src/assets/styles.css"
  },
  "scripts": {
    "build:browser": "node ./scripts/build-browser.mjs",
    "check": "node ./scripts/build-browser.mjs --check && tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node ../../scripts/run-package-test.mjs"
  },
  "dependencies": {
    "@wanex/assistant": "workspace:*",
    "lucide-react": "1.28.0",
    "micromark": "4.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "esbuild": "0.28.1",
    "happy-dom": "20.11.1"
  }
}
