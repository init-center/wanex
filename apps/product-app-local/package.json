{
  "name": "@wanex/product-app-local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./desktop-host": "./src/desktop-host.ts",
    "./web-host": "./src/web-host/index.ts"
  },
  "bin": {
    "wanex-product-app-local": "./src/main.ts"
  },
  "scripts": {
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node ../../scripts/run-package-test.mjs",
    "start": "tsx ./src/main.ts",
    "demo:web": "tsx ./src/demo-main.ts",
    "test:demo:web": "node ../../scripts/run-package-test.mjs demo --maxWorkers=1"
  },
  "dependencies": {
    "@wanex/product-app": "workspace:*",
    "@wanex/product-app-web": "workspace:*",
    "@wanex/protocol": "workspace:*",
    "@wanex/runtime": "workspace:*",
    "@wanex/storage": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "20.11.1"
  }
}
