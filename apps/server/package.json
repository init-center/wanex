{
  "name": "@wanex/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cli/config": "./src/cli/config.ts"
  },
  "bin": {
    "wanex-server": "./src/cli/main.ts"
  },
  "scripts": {
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node ../../scripts/run-package-test.mjs",
    "start": "tsx ./src/cli/main.ts",
    "build:distribution": "node ../../scripts/build-server-distribution.mjs"
  },
  "dependencies": {
    "@wanex/assistant-host": "workspace:*",
    "@wanex/coding": "workspace:*",
    "@wanex/runtime": "workspace:*",
    "@wanex/storage": "workspace:*",
    "@wanex/workspace": "workspace:*"
  }
}
