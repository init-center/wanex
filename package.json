{
  "name": "wanex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "check": "pnpm -r --if-present check",
    "test": "node ./scripts/test.mjs",
    "build": "node ./scripts/build.mjs",
    "build:sdk": "node ./scripts/build-sdk.mjs",
    "pack:sdk": "node ./scripts/pack-sdk.mjs",
    "api:sdk": "node ./scripts/run-sdk-api-reports.mjs",
    "api:sdk:update": "node ./scripts/run-sdk-api-reports.mjs --update",
    "release:sdk": "node ./scripts/release-sdk.mjs",
    "proof:sdk-consumers": "node ./scripts/run-external-consumers.mjs",
    "stage:native": "tsx ./scripts/stage-native-artifact.ts",
    "release:native": "tsx ./scripts/release-native-package.ts",
    "test:native-artifact": "vitest run ./scripts/native-artifact/staging.test.ts ./scripts/native-artifact/npm-package.test.ts",
    "proof:native-runtime": "tsx ./scripts/proof-native-runtime.ts",
    "test:native-runtime-proof": "vitest run ./scripts/proof-native-runtime.test.ts",
    "build:desktop": "pnpm --filter @wanex/desktop build",
    "check:desktop": "pnpm --filter @wanex/desktop check",
    "test:desktop": "pnpm --filter @wanex/desktop test",
    "proof:desktop": "pnpm --filter @wanex/desktop proof",
    "prepare:desktop-electron": "pnpm --filter @wanex/desktop prepare:electron",
    "start:desktop": "pnpm --filter @wanex/desktop start",
    "generate:storage-rpc": "node ./scripts/generate-storage-rpc.mjs",
    "generate:model-catalog": "tsx ./scripts/generate-local-model-catalog.ts",
    "smoke:local-host": "node ./scripts/run-local-host-smoke.mjs",
    "smoke:product-feedback": "node ./scripts/run-eval-harness.mjs --only product.app-feedback-matrix-contract",
    "setup:local-provider": "node ./scripts/run-local-host-smoke.mjs --setup-provider",
    "demo:web": "pnpm --filter @wanex/local-host demo:web",
    "demo:web:seeded": "pnpm --filter @wanex/local-host demo:web",
    "demo:web:blank": "pnpm --filter @wanex/local-host demo:web -- --no-seed",
    "demo:tui": "node ./scripts/run-tui.mjs overview",
    "demo:tui:json": "node ./scripts/run-tui.mjs overview --json",
    "demo:tui:interactive": "node ./scripts/run-tui.mjs interactive",
    "demo:tui:fullscreen": "node ./scripts/run-tui.mjs fullscreen",
    "build:tui": "pnpm --filter @wanex/tui build:distribution",
    "proof:tui": "node ./scripts/prove-tui-distribution.mjs",
    "doctor:toolchain": "node ./scripts/doctor-toolchain.mjs",
    "test:toolchain-doctor": "vitest run ./scripts/doctor-toolchain.test.mjs",
    "test:web-demo": "pnpm --filter @wanex/local-host test:demo:web",
    "test:local-host-smoke-script": "vitest run ./scripts/run-local-host-smoke.test.mjs",
    "test:tui-script": "vitest run ./scripts/run-tui.test.mjs ./scripts/prove-tui-distribution.test.mjs",
    "test:verify-script": "vitest run ./scripts/verify.test.mjs ./scripts/run-eval-harness.test.mjs",
    "test:public-contract-audit": "vitest run ./scripts/audit-public-contracts.test.mjs",
    "test:workspace-hygiene-audit": "vitest run ./scripts/audit-workspace-hygiene.test.mjs",
    "test:package-packlist-audit": "vitest run ./scripts/audit-package-packlist.test.mjs",
    "test:package-governance-audit": "vitest run ./scripts/audit-package-governance.test.mjs",
    "test:facade-footprint-audit": "vitest run ./scripts/audit-facade-footprint.test.mjs",
    "test:sdk-distribution": "vitest run ./scripts/sdk/distribution-policy.test.mjs ./scripts/sdk/artifact-policy.test.mjs ./scripts/external-consumers/registry.test.mjs ./scripts/external-consumers/fixture-policy.test.mjs ./scripts/external-consumers/runner.test.mjs",
    "test:storage-rpc-ownership-audit": "vitest run ./scripts/audit-storage-rpc-ownership.test.mjs",
    "test:storage-rpc-schema": "vitest run ./scripts/storage-rpc-schema.test.mjs",
    "test:storage-rpc-schema-migration-policy": "vitest run ./scripts/storage-rpc-schema-migration-policy.test.mjs",
    "verify": "node ./scripts/verify.mjs",
    "audit:structure": "node ./scripts/audit-structure.mjs",
    "audit:workspace-hygiene": "node ./scripts/audit-workspace-hygiene.mjs",
    "audit:public-contracts": "node ./scripts/audit-public-contracts.mjs",
    "audit:distribution": "node ./scripts/audit-distribution.mjs",
    "audit:distribution-graph": "node ./scripts/audit-distribution-graph.mjs",
    "audit:distribution-footprint": "node ./scripts/audit-distribution-footprint.mjs",
    "audit:package-packlist": "node ./scripts/audit-package-packlist.mjs",
    "audit:package-governance": "node ./scripts/audit-package-governance.mjs",
    "audit:facade-footprint": "node ./scripts/audit-facade-footprint.mjs --enforce",
    "audit:sdk-artifacts": "node ./scripts/audit-sdk-artifacts.mjs",
    "audit:sdk-determinism": "node ./scripts/audit-sdk-determinism.mjs",
    "audit:sdk-packages": "node ./scripts/validate-sdk-packages.mjs",
    "security:js": "node ./scripts/audit-javascript-dependencies.mjs",
    "security:rust": "cargo audit",
    "smoke:sdk-external": "node ./scripts/smoke-sdk-external.mjs",
    "audit:storage-boundary": "node ./scripts/audit-storage-boundary.mjs",
    "audit:storage-rpc-generation": "node ./scripts/generate-storage-rpc.mjs --check",
    "audit:storage-rpc-ownership": "node ./scripts/audit-storage-rpc-ownership.mjs",
    "audit:runtime-consolidation": "node ./scripts/audit-runtime-consolidation.mjs",
    "audit:host-distribution": "node ./scripts/audit-host-distribution.mjs",
    "test:host-distribution-budget": "vitest run ./scripts/audit-host-distribution.test.mjs",
    "test:runtime-consolidation-audit": "vitest run ./scripts/audit-runtime-consolidation.test.mjs",
    "test:runner": "vitest run ./scripts/test-runner.test.mjs ./scripts/process-step.test.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@microsoft/api-extractor": "7.58.12",
    "@types/node": "26.1.1",
    "ajv": "8.20.0",
    "esbuild": "0.28.1",
    "json-schema-to-typescript": "15.0.4",
    "publint": "0.3.22",
    "rollup": "4.62.2",
    "rollup-plugin-dts": "6.4.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=11 <12"
  }
}
